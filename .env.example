# GoHighLevel (Settings → Private Integrations). Token starts with pit-. Scopes are listed in docs/setup.md.
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
# The calendar customers book into, and the pipeline plus the stage a booked customer moves to.
# Workflow A in GoHighLevel opens the opportunity in the "New leads" stage of this same pipeline.
GHL_CALENDAR_ID=your-calendar-id
GHL_PIPELINE_ID=your-pipeline-id
GHL_BOOKED_STAGE_ID=your-booked-stage-id
# Optional: the number texts go out from. Leave empty to use the location's default number.
GHL_FROM_NUMBER=
# Optional: your white label app domain, used for contact links in Slack
GHL_APP_URL=https://app.gohighlevel.com

# Shared secret. Make up a long random string. Both GoHighLevel workflows send it as the Bearer token of their
# Custom Webhook action (or as the "secret" Custom Data item of the standard Webhook action).
GHL_WEBHOOK_SECRET=make-up-a-long-random-string

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 is cheaper. The workflow forces a tool call with thinking off,
# so claude-opus-5-5 and the Claude Fable and Mythos models do not work (every call is refused with a settings error).
ANTHROPIC_MODEL=claude-sonnet-5

# Slack incoming webhook for bookings, hand offs and emergencies (required) and for the error alert workflow
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Put in front of emergency alerts so the channel gets pinged. Not set: <!here>. Set but empty: no mention.
SLACK_EMERGENCY_MENTION=<!here>

# The business, as the assistant describes it
BUSINESS_NAME=Northside Plumbing
BUSINESS_ABOUT=a family-owned plumbing company
# The only facts the assistant may use to answer questions. Anything not listed here goes to a person.
BUSINESS_FAQ=Open Monday to Friday, 7 AM to 6 PM, and Saturday, 8 AM to 2 PM. We serve Northside and towns within 20 miles. The service call fee is $89 and goes toward the repair if you hire us. Water heater replacement estimates are free. We repair and install water heaters, fix leaks, clear drains and replace fixtures. We take card, check and cash.
# Time zone for quiet hours, open times and the times in texts and notes
BUSINESS_TZ=America/Chicago

# The assistant does not text between these times (business time zone). Claude still reads each message: an emergency
# or an opt out is handled at once, anything else waits and is answered when quiet hours end. Leave both empty to
# answer at any hour.
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00

# Optional, comma separated: words that skip the AI and alert the team at once. Empty uses the plumbing list in the
# workflow (emergency, flood, flooding, flooded, burst pipe, no water, gas smell, gas leak, sewage backup and more).
EMERGENCY_WORDS=
# Optional: the text an emergency gets. Empty uses the default (on-call plumber alerted, gas safety line).
# Make it match your real on-call process.
EMERGENCY_REPLY=

# Prefix of the tags the GoHighLevel workflows and n8n use (missed-call, missed-call-booked, and so on).
# If you change it, change the tags in ghl/native-workflows.md too.
TAG_PREFIX=missed-call
# Assistant texts per conversation before a person takes over (2 more are allowed while offered times are open)
MAX_AI_REPLIES=6
# A conversation that has been quiet this many days starts over
CONVERSATION_DAYS=14
# Length of a booked visit. Use the calendar's own slot length.
APPOINTMENT_MINUTES=60
SLOT_SEARCH_DAYS=7
# false: an opt out sets DND for SMS only. true: DND for every channel.
DND_ALL_CHANNELS=false

# Optional: the URL n8n uses to hand held messages back to itself when quiet hours end. Leave empty to use the
# webhook's own URL. Set it (for example http://localhost:5678/webhook/ghl-missed-call-text-back) if n8n cannot
# reach its public URL from inside its own network.
SELF_WEBHOOK_URL=

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
